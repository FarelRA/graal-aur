# Maintainer: Your Name <you@example.com>

pkgname=python-graalpy-oracle-bin
pkgver=25.2.4
pkgrel=1
pkgdesc="Python 3.12 on GraalVM as a drop-in replacement for CPython (Oracle GraalVM native standalone)"
arch=('x86_64'
      'aarch64')
url='https://www.graalvm.org/python/'
license=('custom:GraalVM Free Terms and Conditions')
depends=(
    'gcc-libs'
    'zlib'
)
provides=(
    'python=3.12'
    'python3=3.12'
)
conflicts=(
    'python'
    'python3'
    'graalpy-bin'
    'graalpy-oracle-bin'
    'python-graalpy-bin'
)
options=('!strip')
source_x86_64=("https://github.com/oracle/graalpython/releases/download/graal-${pkgver}/graalpy3.12-${pkgver}-linux-amd64.tar.gz")
source_aarch64=("https://github.com/oracle/graalpython/releases/download/graal-${pkgver}/graalpy3.12-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('b3d0766ae6d55daa15f0db1f6c884383d7eec506b186d0ba2f702523a78ff28d')
sha256sums_aarch64=('e57472272b1b659ae6ac972117723b0515a49cc9577688ed5563919793170d67')

package() {
    local _dir

    _dir=$(find "$srcdir" -mindepth 1 -maxdepth 1 -type d -name 'graalpy*' -print -quit)

    install -dm755 "$pkgdir/usr/lib/graalpy"
    cp -a "$_dir"/bin "$_dir"/lib "$_dir"/libexec "$_dir"/include -t "$pkgdir/usr/lib/graalpy/"

    install -Dm644 "$_dir/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$_dir/license-information-user-manual.zip" "$pkgdir/usr/share/licenses/$pkgname/license-information-user-manual.zip"
    install -Dm644 "$_dir/README_GRAALPY.md" "$pkgdir/usr/share/doc/$pkgname/README_GRAALPY.md"

    install -dm755 "$pkgdir/usr/bin"
    ln -s ../lib/graalpy/bin/python "$pkgdir/usr/bin/python"
    ln -s ../lib/graalpy/bin/python3 "$pkgdir/usr/bin/python3"
}
